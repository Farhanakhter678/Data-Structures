class Solution {
    public int[] twoSum(int[] arr, int target) {
        //  ArrayList<ArrayList<Integer>> finall = new ArrayList<>();
        int i = 0;
        int j = arr.length-1;
        // int k = 0; // your index for last added element
        int [] pair = new int[2];
        while (i < j) {
            int sum = arr[i] + arr[j];

            if (sum == target) {
               pair[0] = i+1;
               pair[1] = j+1;
                return pair;
            }
            else if (sum > target) {
                j--;
            } else {
                i++;
            }
        }

        return pair;
    }
}
