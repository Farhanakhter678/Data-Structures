import java.util.Collections;
class Solution {
    public void moveZeroes(int[] arr) {
        int i =0;
        for(int k =0; k<arr.length;k++){
            if(arr[k]==0){
                i=k;break;
            }
       
        }
         int j = i+1;
        while(j < arr.length){
        if(arr[j] == 0){
            j++;
        }
    else if(arr[i] == 0){
       int temp = arr[i];
       arr[i]=arr[j];
       arr[j]=temp;
        i++;
        j++;
    }
    else{
        i++;
        j++;
    }


        }
}
}
