class Solution {
    public boolean isPalindrome(String s) {
         boolean palin = true;
         if (s.length() == 0||s.length()==1){
            return true;
         }
         s = s.toLowerCase();
        int len = s.length();

        int l = 0, r = len-1;
        while(l<r){
             if(Character.isLetterOrDigit(s.charAt(l))==false){l++;continue;}
            if(Character.isLetterOrDigit(s.charAt(r))==false) {r--;continue;}
            if(s.charAt(l)!=s.charAt(r)){
                return false;
        }l++;r--;
        }
     
        return palin;
    }
}
