class Solution(object):
    def groupAnagrams(self, strs):
        """
        :type strs: List[str]
        :rtype: List[List[str]]
        """
        
        group = {}

        for i in strs:
            key = tuple(sorted(i))
            if key in group:
                group[key].append(i)
            else:
                group[key] = [i]

        return list(group.values())
